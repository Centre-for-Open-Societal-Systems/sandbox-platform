# ------------------------------------------------------------------ app
APP_NAME=OAN Sandbox Backend
ENV=sandbox
DEBUG=true
PORT=8000
API_PREFIX=/oan
DEFAULT_COUNTRY_CODE=ET

# ------------------------------------------------------------- database
DB_DRIVER=postgresql+psycopg
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sandbox_db_oan
DB_SCHEMA=public
DB_ECHO=false

# ----------------------------------------------------------------- auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_TOKEN_KEY=
JWT_REFRESH_TOKEN_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400
BCRYPT_ROUNDS=10

# Set to true once the RSA keypair is provisioned and the frontend seals
# credentials before posting them.
RSA_PAYLOAD_ENABLED=false
RSA_PRIVATE_KEY_PATH=keys/private_key.pem
RSA_PUBLIC_KEY_PATH=keys/public_key.pem

# ----------------------------------------------------------------- cors
ALLOWED_ORIGINS=http://localhost:3000
# Web client base URL for links in emails (reset password, invitations).
PORTAL_URL=http://localhost:3000

# ---------------------------------------------------------------- redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------- upload
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
STORAGE_BACKEND=local
STORAGE_BUCKET=

# ----------------------------------------------------------------- mail
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@openagrinet.org
SMTP_TLS=true
# Developer machine only (ENV=local, mail off): a participant password reset
# accepts this 6-digit code. Ignored on every other ENV and never valid for
# administrators (use backend/scripts/set_admin_password.py). Keep it empty.
DEV_FIXED_OTP=

# -------------------------------------------------------- api gateway
# Products/end-points flagged "served through the API gateway" and with no
# upstream URL of their own are called on the gateway proxy of the environment.
# GATEWAY_BASE_URL is the fallback for an environment left blank.
GATEWAY_ENABLED=false
GATEWAY_BASE_URL=
GATEWAY_UAT_URL=
GATEWAY_PROD_URL=
# The gateway as partners reach it (code samples, try-it URL, API history), when
# the URLs above are internal-only. Empty = same as above.
GATEWAY_UAT_PUBLIC_URL=
GATEWAY_PROD_PUBLIC_URL=
SANDBOX_PROXY_TIMEOUT=30
# "Pull from gateway" in the console: reads the gateway's Admin API and adds or
# updates catalogue end-points from its routes. GATEWAY_TYPE: apisix or kong.
# GATEWAY_ADMIN_URL: Admin API (APISIX http://host:9180, Kong http://host:8001).
# GATEWAY_ADMIN_TOKEN: APISIX admin key (X-API-KEY) or Kong admin token.
GATEWAY_SYNC_ENABLED=false
GATEWAY_TYPE=apisix
GATEWAY_ADMIN_URL=
GATEWAY_ADMIN_TOKEN=
# Production's own APISIX (Admin API + key). Empty = production uses the gateway above.
GATEWAY_PROD_ADMIN_URL=
GATEWAY_PROD_ADMIN_TOKEN=

# Participant apps (My Apps): each app is written to the gateway as an APISIX
# consumer with its API key + secret and a whitelist of the routes its API
# products cover. Needs GATEWAY_ADMIN_URL with write access and GATEWAY_TYPE=apisix.
# APP_CREDENTIAL_ENCRYPTION_KEY encrypts stored keys/secrets; required on every server except ENV=local
# (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Never change it once keys are issued - stored keys become unreadable.
GATEWAY_APP_SYNC_ENABLED=false
GATEWAY_APP_KEY_HEADER=apikey
# How the API gateway identifies the calling partner: apikey (an app's API key, default),
# keycloak (the participant's Keycloak access token in GATEWAY_PARTNER_TOKEN_HEADER, checked
# by the gateway; try-it sends the signed-in participant's token; needs
# PARTICIPANT_AUTH_PROVIDER=keycloak and a gateway built with PARTNER_AUTH=keycloak) or
# oauth (OAuth 2.0 client credentials: every app key is also a Keycloak client, client_id =
# API key, client_secret = API secret; the partner sends only the app's access token in
# GATEWAY_PARTNER_TOKEN_HEADER; the try-it page has "Get token"; needs
# KEYCLOAK_PROVISIONING_ENABLED, GATEWAY_APP_SYNC_ENABLED and a gateway built with
# PARTNER_AUTH=oauth, on Kubernetes the chart deploy/apisix-partner-gateway/k8s).
GATEWAY_PARTNER_AUTH=apikey
GATEWAY_PARTNER_TOKEN_HEADER=X-Partner-Token
APP_CREDENTIAL_ENCRYPTION_KEY=
MAX_APPS_PER_PARTICIPANT=10
MAX_ACTIVE_CREDENTIALS_PER_APP=2
APP_KEY_LIFETIME_DAYS=0
APP_KEY_ROTATION_GRACE_DAYS=7
APP_KEY_EXPIRY_WARN_DAYS=14
APP_KEY_MAINTENANCE_MINUTES=60
# Hours to answer a support query before the console marks it overdue (0 = no SLA).
SUPPORT_SLA_HOURS=72
# Support mailbox told when a participant writes on a ticket (empty = nobody is mailed).
SUPPORT_NOTIFY_EMAIL=
# Close an answered ticket after this many days without a reply from the participant (0 = never).
SUPPORT_AUTO_CLOSE_DAYS=0
# Most messages one ticket can hold.
SUPPORT_MAX_MESSAGES_PER_TICKET=100
# Delete audit entries (console "User tracking") older than this many days; 0 = keep forever.
AUDIT_LOG_RETENTION_DAYS=0
# Optional IP whitelist per app: most addresses a participant may list.
MAX_ALLOWED_IPS_PER_APP=20
# Gateway logs callback: each app's APISIX consumer gets http-logger, which posts
# call records to POST <API>/oan/internal/gateway/logs, so API history also shows
# direct calls (Postman, the participant's servers). Off: try-it calls only.
# URL = the callback as APISIX reaches it; TOKEN = long random secret
# (python -c "import secrets; print(secrets.token_urlsafe(32))").
GATEWAY_LOG_INGEST_ENABLED=false
GATEWAY_LOG_INGEST_URL=
GATEWAY_LOG_INGEST_TOKEN=
GATEWAY_LOG_FLUSH_SECONDS=5
# Rate limits per API product (APISIX limit-count on each app's consumer, 429 when
# crossed). POLICY local = counted per APISIX node; redis = shared (set REDIS_HOST
# as APISIX reaches it).
GATEWAY_RATE_LIMIT_ENABLED=false
GATEWAY_RATE_LIMIT_POLICY=local
GATEWAY_RATE_LIMIT_REDIS_HOST=
GATEWAY_RATE_LIMIT_REDIS_PORT=6379
GATEWAY_RATE_LIMIT_REDIS_PASSWORD=
# Participant users (Keycloak): every participant becomes a user of the realm at sign-up
# (username = email, same password as the portal, kept in sync). Approving an environment
# gives the user that environment's role (sandbox / uat / production) of the shared client
# KEYCLOAK_PARTNER_CLIENT_ID; partners get a token with the password grant on that client.
# The sandbox signs in as its own service account, never the Keycloak admin: create the realm,
# the shared client and that account with backend/scripts/keycloak/setup_partner_realm.py.
KEYCLOAK_PROVISIONING_ENABLED=false
KEYCLOAK_URL=
KEYCLOAK_PUBLIC_URL=
# partner: the realm the Consent Manager chart makes (dev: keycloak.development.oanstaging.com).
KEYCLOAK_REALM=partner
KEYCLOAK_ADMIN_CLIENT_ID=oan-sandbox-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ENVIRONMENTS=UAT,PRODUCTION
KEYCLOAK_PARTNER_CLIENT_ID=oan-partner-api
# Production's own Keycloak (GATEWAY_PARTNER_AUTH=oauth): the clients of production apps
# ("Move to production"; their own keys) are written there, tokens naming only
# "production". Run setup_partner_realm.py against it.
# Empty KEYCLOAK_PROD_URL = production apps use the Keycloak above.
KEYCLOAK_PROD_URL=
KEYCLOAK_PROD_PUBLIC_URL=
# Empty realm / client id = the same as KEYCLOAK_REALM / KEYCLOAK_ADMIN_CLIENT_ID.
KEYCLOAK_PROD_REALM=
KEYCLOAK_PROD_ADMIN_CLIENT_ID=
KEYCLOAK_PROD_ADMIN_CLIENT_SECRET=
KEYCLOAK_PROD_JWKS_URL=
# OpenG2P Consent Manager partner portal (optional): the same Keycloak user signs in to the
# CM partner portal. Set KEYCLOAK_REALM to the CM's partner realm (partner, made by the CM
# chart) and KEYCLOAK_PORTAL_CLIENT_ID to its portal client; an approved participant then
# gets the attribute partner_id = PARTNER_ID_PREFIX + participant id (never change the prefix
# once partners exist) and the portal client role KEYCLOAK_PORTAL_ROLE. Empty client id: off.
KEYCLOAK_PORTAL_CLIENT_ID=
KEYCLOAK_PORTAL_ROLE=PARTNER_OPERATOR
KEYCLOAK_PARTNER_ID_ATTRIBUTE=partner_id
PARTNER_ID_PREFIX=oan-p-
# Participant sign-in with Keycloak (optional, needs the Keycloak provisioning settings above).
# local (default): the sandbox checks its own password hash and issues its own tokens.
# keycloak: Keycloak checks the password and issues the tokens; the portal's sign-in form stays.
# The API signs in with the confidential client KEYCLOAK_LOGIN_CLIENT_ID (direct grant; made by
# backend/scripts/keycloak/setup_partner_realm.py, which writes its secret) and verifies every
# Keycloak access token itself: RS256 from KEYCLOAK_JWKS_URL, iss = KEYCLOAK_ISSUER, exp, typ, azp.
# KEYCLOAK_ISSUER: what Keycloak writes into tokens (its public hostname); empty = derived.
PARTICIPANT_AUTH_PROVIDER=local
KEYCLOAK_LOGIN_CLIENT_ID=oan-sandbox-portal
KEYCLOAK_LOGIN_CLIENT_SECRET=
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URL=
KEYCLOAK_TOKEN_LEEWAY_SECONDS=30
KEYCLOAK_JWKS_CACHE_SECONDS=300
# OpenG2P Partner Management (optional, needs the portal settings above): an approved
# participant is onboarded and approved as PM partner PARTNER_<PARTNER ID>, disabled while it
# has no access. The sandbox signs in with its own service-account client (in the realm PM's
# staff API trusts, holding PM's admin role, e.g. client role partner-management/partner_manager).
# PM reads the partner's keys from PM_PARTNER_JWKS_BASE_URL/partners/<partner id>/jwks.json
# (this API, as PM reaches it). PM_DEFAULT_POLICIES: JSON list of PM policies given at
# onboarding; [] = none (PM staff add them; the portal shows no access until then).
PM_PROVISIONING_ENABLED=false
PM_STAFF_API_URL=
PM_TOKEN_URL=
PM_CLIENT_ID=oan-sandbox-pm
PM_CLIENT_SECRET=
PM_TIMEOUT=15
PM_PARTNER_JWKS_BASE_URL=
PM_DEFAULT_POLICIES=[]
# true: try-it answers endpoints that have no gateway route from their stored samples.
# false (default): every try-it call goes through the API gateway.
SANDBOX_MOCK_RESPONSES=false
GATEWAY_ADMIN_TIMEOUT=15

# -------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_DIR=logs

# ------------------------------------------------------------- seeding
# Consumed by `python -m app.seeds.seed`; never commit a real value.
SEED_ADMIN_EMAIL=admin@openagrinet.org
SEED_ADMIN_PASSWORD=
