# ------------------------------------------------------------------ app
APP_NAME=OAN Sandbox Backend
ENV=sandbox
DEBUG=true
PORT=8000
API_PREFIX=/oan
DEFAULT_COUNTRY_CODE=ET

# ------------------------------------------------------------- database
DB_DRIVER=postgresql+psycopg
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sandbox_db_oan
DB_SCHEMA=public
DB_ECHO=false

# ----------------------------------------------------------------- auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_TOKEN_KEY=
JWT_REFRESH_TOKEN_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400
BCRYPT_ROUNDS=10

# Set to true once the RSA keypair is provisioned and the frontend seals
# credentials before posting them.
RSA_PAYLOAD_ENABLED=false
RSA_PRIVATE_KEY_PATH=keys/private_key.pem
RSA_PUBLIC_KEY_PATH=keys/public_key.pem

# ----------------------------------------------------------------- cors
ALLOWED_ORIGINS=http://localhost:3000
# Web client base URL for links in emails (reset password, invitations).
PORTAL_URL=http://localhost:3000

# ---------------------------------------------------------------- redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------- upload
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
STORAGE_BACKEND=local
STORAGE_BUCKET=

# ----------------------------------------------------------------- mail
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@openagrinet.org
SMTP_TLS=true
# While MAIL_ENABLED=false every sign-up verification code is DEV_FIXED_OTP
# (6 digits), because no email can be sent. Ignored when mail is on or ENV=production.
# Leave empty to always generate random codes.
DEV_FIXED_OTP=000000

# -------------------------------------------------------- api gateway
# Products/end-points flagged "served through the API gateway" and with no
# upstream URL of their own are called on the gateway proxy of the environment.
# GATEWAY_BASE_URL is the fallback for an environment left blank.
GATEWAY_ENABLED=false
GATEWAY_BASE_URL=
GATEWAY_SANDBOX_URL=
GATEWAY_UAT_URL=
GATEWAY_PROD_URL=
GATEWAY_ADMIN_TOKEN=
SANDBOX_PROXY_TIMEOUT=30

# -------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_DIR=logs

# ------------------------------------------------------------- seeding
# Consumed by `python -m app.seeds.seed`; never commit a real value.
SEED_ADMIN_EMAIL=admin@openagrinet.org
SEED_ADMIN_PASSWORD=
