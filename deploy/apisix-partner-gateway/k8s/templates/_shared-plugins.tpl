{{/*
# OAN partner APIs (sandbox apps, GATEWAY_PARTNER_AUTH=oauth): APISIX Ingress Controller resources.
# Generated by deploy/apisix-partner-gateway/generate_k8s_chart.py from partner-apis.adc.yaml -- do not hand-edit;
# change build_apisix_config.py and re-run.
*/}}
{{- define "partnerGateway.plugins.consent-manager-partner-portal-api" -}}
- name: proxy-rewrite
  enable: true
  config:
    regex_uri:
    - ^/consent-manager/(.*)
    - /$1
- name: serverless-pre-function
  enable: true
  config:
    phase: rewrite
    functions:
    - |-
      return function(conf, ctx)
        local core = require("apisix.core")
        local token = core.request.header(ctx, "X-Partner-Token")
        local upstream = core.request.header(ctx, "Authorization")
        ctx.oan_x_access_token = core.request.header(ctx, "X-Access-Token")
        for _, name in ipairs({"X-Partner-Token", "X-Access-Token", "X-Userinfo",
                               "X-OAN-Partner-Id", "X-OAN-App", "X-OAN-Upstream-Authorization"}) do
          core.request.set_header(ctx, name, nil)
        end
        if type(token) ~= "string" or token == "" then
          core.response.set_header("WWW-Authenticate", 'Bearer realm="partner"')
          return 401, {message = "Missing app token (X-Partner-Token)"}
        end
        token = token:gsub("^[Bb][Ee][Aa][Rr][Ee][Rr]%s+", "")
        core.request.set_header(ctx, "X-OAN-Upstream-Authorization", upstream)
        core.request.set_header(ctx, "Authorization", "Bearer " .. token)
      end
- name: openid-connect
  enable: true
  config:
    client_id: oan-apisix-gateway
    discovery: {{ include "partnerGateway.discovery" . }}
    bearer_only: true
    use_jwks: true
    realm: partner
    set_userinfo_header: true
    set_access_token_header: false
    iat_slack: 30
    accept_unsupported_alg: false
    accept_none_alg: false
    claim_validator:
      issuer:
        valid_issuers:
        - {{ include "partnerGateway.issuer" . }}
    claim_schema:
      type: object
      required:
      - typ
      - participant_uid
      - oan_app
      - oan_environments
      - oan_routes
      properties:
        typ:
          const: Bearer
        participant_uid:
          type: string
          minLength: 1
        oan_app:
          type: string
          minLength: 1
        oan_environments:
          type: array
          contains:
            const: {{ required "environmentRole is required" .Values.environmentRole }}
        oan_routes:
          type: array
          items:
            type: string
- name: serverless-post-function
  enable: true
  config:
    phase: rewrite
    functions:
    - |-
      return function(conf, ctx)
        local core = require("apisix.core")
        local info = core.request.header(ctx, "X-Userinfo")
        local claims = info and core.json.decode(ngx.decode_base64(info) or "")
        -- jwt-auth with hide_credentials removed it: then the upstream gets no Authorization.
        local upstream = core.request.header(ctx, "X-OAN-Upstream-Authorization")
        core.request.set_header(ctx, "X-Userinfo", nil)
        core.request.set_header(ctx, "X-OAN-Upstream-Authorization", nil)
        core.request.set_header(ctx, "Authorization", upstream)
        core.request.set_header(ctx, "X-Access-Token", ctx.oan_x_access_token)
        if type(claims) ~= "table" or type(claims.participant_uid) ~= "string"
            or type(claims.oan_app) ~= "string" or type(claims.oan_routes) ~= "table" then
          return 401, {message = "Invalid app token"}
        end
        -- Set before the grant check, so a refused call is still logged against its app.
        core.request.set_header(ctx, "X-OAN-Partner-Id", claims.participant_uid)
        core.request.set_header(ctx, "X-OAN-App", claims.oan_app)
        -- The app's API products: the route ids its token was issued with.
        local granted = false
        for _, id in ipairs(claims.oan_routes) do
          if id == ctx.route_id then
            granted = true
            break
          end
        end
        if not granted then
          return 403, {message = "This app has no access to this API"}
        end
        -- The app's IP whitelist (oan_ips; empty = any address). A list that cannot be read
        -- refuses the call rather than letting it through.
        local ips = claims.oan_ips
        if type(ips) == "table" and #ips > 0 then
          local matcher = require("resty.ipmatcher").new(ips)
          if not matcher or not matcher:match(ctx.var.remote_addr) then
            return 403, {message = "This app does not accept calls from your IP address"}
          end
        end
        -- The app's own limits (the most generous of its API products; 0 = none), read by
        -- limit-count. A rule whose key is not set does not apply.
        local minute, day = tonumber(claims.oan_limit_minute), tonumber(claims.oan_limit_day)
        if minute and minute > 0 then
          ctx.var.oan_limit_minute = minute
          ctx.var.oan_limit_minute_key = claims.oan_app .. ":minute"
        end
        if day and day > 0 then
          ctx.var.oan_limit_day = day
          ctx.var.oan_limit_day_key = claims.oan_app .. ":day"
        end
      end
{{- if .Values.callLog.enabled }}
- name: http-logger
  enable: true
  config:
    uri: {{ required "callLog.url is required" .Values.callLog.url }}
    auth_header: $env://OAN_SANDBOX_LOG_INGEST_AUTHORIZATION
    batch_max_size: 100
    inactive_timeout: 5
    timeout: 5
{{- end }}
- name: limit-count
  enable: true
  config:
    rules:
    - count: $oan_limit_minute
      time_window: 60
      key: $oan_limit_minute_key
      header_prefix: Minute
    - count: $oan_limit_day
      time_window: 86400
      key: $oan_limit_day_key
      header_prefix: Day
    - count: 120
      time_window: 60
      key: $http_x_oan_app:$route_id
      header_prefix: Route
    rejected_code: 429
    rejected_msg: Rate limit exceeded for this app. Try again later or ask for a higher limit.
    show_limit_quota_header: true
    allow_degradation: true
{{- if .Values.redis.host }}
    policy: redis
    redis_host: {{ .Values.redis.host | quote }}
    redis_port: {{ .Values.redis.port }}
{{- end }}
{{- end }}
