    {
      "name": "2.1 Get All Sections",
      "event": [
        {
          "script": {
            "exec": [
              "const sections = (pm.response.json().response_body || {}).response_payload || [];",
              "const wanted = pm.collectionVariables.get('CR_SECTION_ID');",
              "const section = sections.find(s => s.section_id === wanted);",
              "pm.test(`section ${wanted} exists`, () => pm.expect(section).to.be.an('object'));",
              "if (section) {",
              "    pm.collectionVariables.set('CR_SECTION_REGISTER_ID', section.section_register_id);",
              "    // Core sections have their own change-request controller.",
              "    pm.collectionVariables.set('CR_CREATE_PATH', section.is_core_section",
              "        ? '/change-requests-core-data/create_change_request_for_core_data'",
              "        : '/change-requests/create_change_request');",
              "}"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
