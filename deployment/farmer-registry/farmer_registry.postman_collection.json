    {
      "name": "2.3 Create Change Request",
      "event": [
        {
          "script": {
            "exec": [
              "// A change request that changes nothing is rejected, so pick a different middle name.",
              "const names = ['Alemu', 'Tesfaye', 'Worku', 'Getachew', 'Haile', 'Desta'];",
              "const old = pm.collectionVariables.get('CR_OLD_MIDDLE_NAME');",
              "const choices = names.filter(n => n !== old);",
              "pm.collectionVariables.set('CR_NEW_MIDDLE_NAME', choices[Math.floor(Math.random() * choices.length)]);"
            ],
            "type": "text/javascript"
          },
          "listen": "prerequest"
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"request_header\": {\n        \"sender_app_mnemonic\": \"Postman Load Test\",\n        \"sender_app_url\": \"postman\",\n        \"request_id\": \"{{$guid}}\",\n        \"request_timestamp\": \"{{$isoTimestamp}}\"\n    },\n    \"request_body\": {\n        \"pagination_request\": {\n            \"current_page\": 1,\n            \"page_size\": 20,\n            \"sort_by\": \"\",\n            \"filter_by\": \"\",\n            \"search_text\": \"\"\n        },\n        \"request_payload\": {\n            \"register_id\": \"{{REGISTER_FARMER}}\",\n            \"tab_id\": \"{{CR_TAB_ID}}\",\n            \"section_id\": \"{{CR_SECTION_ID}}\",\n            \"section_register_id\": \"{{CR_SECTION_REGISTER_ID}}\",\n            \"internal_record_id\": \"{{SUBJECT_INTERNAL_ID}}\",\n            \"change_payload\": [\n                {\n                    \"internal_record_id\": \"{{TARGET_INTERNAL_ID}}\",\n                    \"edit_action\": \"UPDATE\",\n                    \"middle_name\": \"{{CR_NEW_MIDDLE_NAME}}\"\n                }\n            ],\n            \"documents\": null\n        }\n    }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{STAFF_API_BASE}}{{CR_CREATE_PATH}}",
          "host": [
            "{{STAFF_API_BASE}}{{CR_CREATE_PATH}}"
          ]
        },
        "description": "`internal_record_id` is the subject farmer; `change_payload[].internal_record_id` is the record being edited."
      },
      "response": []
