  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// staff-api refuses every call without a CSRF double-submit (G2P-AUT-403 \"CSRF token",
          "// missing or invalid\"): the same value in an X-CSRF-Token cookie and header.",
          "// Reuse the cookie already in the jar (the server may have set its own), otherwise make one,",
          "// so the header and the cookie that Postman sends can never disagree.",
          "if (!pm.request.url.toString().includes('/protocol/openid-connect/')) {",
          "    const jarValue = pm.cookies.get('X-CSRF-Token');",
          "    const csrf = jarValue || pm.collectionVariables.get('CSRF_TOKEN') || pm.variables.replaceIn('{{$guid}}');",
          "    pm.collectionVariables.set('CSRF_TOKEN', csrf);",
          "    pm.request.headers.upsert({ key: 'X-CSRF-Token', value: csrf });",
          "    if (!jarValue) {",
          "        // Cookie header for this request (desktop app / newman); jar entry for the following ones.",
          "        pm.request.headers.upsert({ key: 'Cookie', value: 'X-CSRF-Token=' + csrf });",
          "        pm.cookies.jar().set(pm.request.url.toString(), 'X-CSRF-Token', csrf, () => {});",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Validation failures come back as HTTP 200 with response_status ERROR, so both are checked.",
          "pm.test('HTTP status is not an error', () => pm.expect(pm.response.code).to.be.below(400));",
          "let json = {};",
          "try { json = pm.response.json(); } catch (e) { /* not JSON */ }",
          "const header = json.response_header;",
          "if (header) {",
          "    pm.test('G2P response_status is not ERROR', () => {",
          "        pm.expect(header.response_status, `${header.response_error_code}: ${header.response_error_message}`).to.not.equal('ERROR');",
          "    });",
          "}"
        ]
      }
    }
