    {
      "name": "2.2 Get Tab Records",
      "event": [
        {
          "script": {
            "exec": [
              "// Records are grouped by section_register_id; the record being edited may differ from the subject.",
              "const groups = (pm.response.json().response_body || {}).response_payload || [];",
              "const registerId = pm.collectionVariables.get('CR_SECTION_REGISTER_ID');",
              "const group = groups.find(g => g.section_register_id === registerId) || {};",
              "const record = (group.records || [])[0];",
              "pm.test('a record to change exists in this tab', () => pm.expect(record).to.be.an('object'));",
              "if (record) {",
              "    pm.collectionVariables.set('TARGET_INTERNAL_ID', record.internal_record_id);",
              "    pm.collectionVariables.set('CR_OLD_MIDDLE_NAME', record.middle_name || '');",
              "}"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
