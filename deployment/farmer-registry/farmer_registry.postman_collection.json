    {
      "name": "3.3 Save Intake Form Submission (personal identification)",
      "event": [
        {
          "script": {
            "exec": [
              "// A new submission starts with submission_id null; the server issues one.",
              "// With INTAKE_REUSE_SUBMISSION=true the section is added to SUBMISSION_ID instead.",
              "const pick = list => list[Math.floor(Math.random() * list.length)];",
              "pm.collectionVariables.set('INTAKE_FIRST_NAME', pick(['Amina', 'Fatuma', 'Hana', 'Tigist', 'Selam', 'Abebe', 'Kebede', 'Meron']));",
              "pm.collectionVariables.set('INTAKE_LAST_NAME', pick(['Bekele', 'Alemu', 'Tesfaye', 'Worku', 'Girma', 'Haile']));",
              "const birth = new Date('1990-01-01T00:00:00Z');",
              "const now = new Date();",
              "let age = now.getUTCFullYear() - birth.getUTCFullYear();",
              "if (now.getUTCMonth() < birth.getUTCMonth() || (now.getUTCMonth() === birth.getUTCMonth() && now.getUTCDate() < birth.getUTCDate())) age--;",
              "pm.collectionVariables.set('INTAKE_ESTIMATED_AGE', String(age));",
              "const current = pm.collectionVariables.get('SUBMISSION_ID');",
              "pm.collectionVariables.set('SUBMISSION_ID_JSON', current && pm.collectionVariables.get('INTAKE_REUSE_SUBMISSION') === 'true' ? JSON.stringify(current) : 'null');"
            ],
            "type": "text/javascript"
          },
          "listen": "prerequest"
        },
        {
          "script": {
            "exec": [
              "const payload = (pm.response.json().response_body || {}).response_payload || {};",
              "pm.test('submission_id returned', () => pm.expect(payload.submission_id).to.be.a('string'));",
              "if (payload.submission_id) pm.collectionVariables.set('SUBMISSION_ID', payload.submission_id);"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"request_header\": {\n        \"sender_app_mnemonic\": \"Postman Load Test\",\n        \"sender_app_url\": \"postman\",\n        \"request_id\": \"{{$guid}}\",\n        \"request_timestamp\": \"{{$isoTimestamp}}\"\n    },\n    \"request_body\": {\n        \"pagination_request\": {\n            \"current_page\": 1,\n            \"page_size\": 20,\n            \"sort_by\": \"\",\n            \"filter_by\": \"\",\n            \"search_text\": \"\"\n        },\n        \"request_payload\": {\n            \"submission_id\": {{SUBMISSION_ID_JSON}},\n            \"section_id\": \"farmer_farmer_personal_identification_section_01\",\n            \"section_register_id\": \"{{REGISTER_FARMER}}\",\n            \"section_payload\": {\n                \"first_name\": \"{{INTAKE_FIRST_NAME}}\",\n                \"middle_name\": \"\",\n                \"last_name\": \"{{INTAKE_LAST_NAME}}\",\n                \"father_first_name\": \"{{INTAKE_LAST_NAME}}\",\n                \"birth_date\": \"1990-01-01\",\n                \"estimated_age\": {{INTAKE_ESTIMATED_AGE}},\n                \"gender\": \"FEMALE\",\n                \"marital_status\": \"MARRIED\",\n                \"education_level\": \"BASIC\"\n            },\n            \"form_id\": \"{{FARMER_INTAKE_FORM_ID}}\",\n            \"register_id\": \"{{REGISTER_FARMER}}\",\n            \"documents\": null\n        }\n    }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
